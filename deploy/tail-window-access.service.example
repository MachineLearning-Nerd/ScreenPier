[Unit]
Description=TailWindowAccess private desktop host
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/libexec/tail-window-access/tail-window-access --owner-login owner@example.com --public-origin https://your-host.your-tailnet.ts.net:8443 --media-ip 100.64.0.1 --output eDP-1 --encoder vaapi --bitrate-kbps 3000
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=graphical-session.target
